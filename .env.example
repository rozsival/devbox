# -- Published-port binding ---------------------------------------------------
# Address the container's sshd is published on, alongside 127.0.0.1. Docker
# publishes ports with `nat/PREROUTING` DNAT, so packets reaching the container
# are forwarded, not delivered locally - they never traverse the `INPUT` chain
# UFW manages, and `ufw deny 2223` cannot block a published port
# (moby/moby#17496). Binding this to the node's Tailscale IP is therefore what
# keeps the devbox off the public internet. Filled by `./bin/devbox env` from
# `tailscale ip -4`; left empty, `up` refuses to start rather than publishing on
# 0.0.0.0.
BIND_ADDR=
DEVBOX_SSH_PORT=2223

# -- Host paths and identity mapping ------------------------------------------
# Absolute path; holds the whole /home/dev tree (dotfiles, keys, projects).
# It must equal the container's home path: the rootless project daemon resolves
# a project's bind mounts as host paths, so `./data:/var/lib/postgresql/data`
# only works when both sides agree on /home/dev (see docs/docker.md).
DEVBOX_DATA_DIR=/home/dev
# The unprivileged host user that owns both the bind mount and the project
# Docker daemon; created by `sudo ./bin/rootless-docker`.
HOST_UID=1001
HOST_GID=1001
TZ=Europe/Prague

# -- Project Docker daemon ----------------------------------------------------
# Directory holding the rootless daemon's socket, bind-mounted into the
# container as /run/devbox. Created by `sudo ./bin/rootless-docker`; the socket
# inside belongs to the `dev` host user, not to root.
DEVBOX_DOCKER_SOCKET_DIR=/run/devbox

# -- SSH access ---------------------------------------------------------------
# Public keys authorized for the devbox are fetched from this GitHub user, plus
# any newline-separated keys in DEVBOX_EXTRA_AUTHORIZED_KEYS.
DEVBOX_GITHUB_USER=rozsival
DEVBOX_EXTRA_AUTHORIZED_KEYS=

# -- Git identities -----------------------------------------------------------
GIT_PERSONAL_NAME="Vít Rozsíval"
GIT_PERSONAL_EMAIL=mail@vitrozsival.cz
GIT_WORK_NAME="Vít Rozsíval"
GIT_WORK_EMAIL=you@work.example

# Secrets are deliberately absent from this file. Tool credentials live in the
# container at ~/.config/devbox/secrets.env (mode 600, on the bind mount) and
# per-project secrets in each project's own .env - both hand-placed, never
# synced by bin/push. See docs/secrets.md.
