#!/usr/bin/env bash
# Laptop-side: copy this machine's identity registry into the devbox, so both
# sides derive their git and token wiring from the same file. Nothing secret
# travels - identities.conf holds names, emails, *public* keys and paths; the
# tokens stay in each machine's own secrets.env and the private keys in
# 1Password. See docs/git.md.
set -euo pipefail

log_info() { echo -e "\033[0;34m[INFO]\033[0m  $*"; }
log_success() { echo -e "\033[0;32m[OK]\033[0m    $*"; }
log_warn() { echo -e "\033[1;33m[WARN]\033[0m  $*" >&2; }
log_error() {
  echo -e "\033[0;31m[ERROR]\033[0m $*" >&2
  exit 1
}

usage() {
  cat <<'USAGE'
Usage: ./bin/sync-identities [ssh-host]

Copies ~/.config/devbox/identities.conf to <ssh-host>:~/.config/devbox/identities.conf,
keeping one backup as identities.conf.bak on the remote side, then re-runs the
identity-derived setup there (~/.ssh/config, ~/.gitconfig, allowed_signers, the
agent gitconfigs).

Arguments:
  ssh-host    devbox SSH host from ~/.ssh/config (default: $DEVBOX_SSH_HOST, then 'devbox')

Environment:
  DEVBOX_SSH_HOST      default SSH host
  DEVBOX_IDENTITIES    source file (default: ~/.config/devbox/identities.conf)
USAGE
}

host="${DEVBOX_SSH_HOST:-devbox}"

for arg in "$@"; do
  case "${arg}" in
  -h | --help)
    usage
    exit 0
    ;;
  -*) log_error "Unknown option: ${arg}" ;;
  *) host="${arg}" ;;
  esac
done

src="${DEVBOX_IDENTITIES:-${HOME}/.config/devbox/identities.conf}"
[[ -f "${src}" ]] || log_error "No identity registry at ${src} - run ./bin/install-agent, then fill it in"

# Locally first: a registry that does not validate must not be the one the
# devbox boots from, and the same reader runs on both sides.
reader="$(dirname "${BASH_SOURCE[0]}")/../home/.local/libexec/devbox-identities"
if [[ -x "${reader}" ]]; then
  DEVBOX_IDENTITIES_FILE="${src}" "${reader}" check || log_error "${src} is not usable; fix it before syncing"
fi

log_info "Backing up the current registry on ${host}..."
ssh "${host}" '
  set -eu
  mkdir -p ~/.config/devbox
  [ -f ~/.config/devbox/identities.conf ] && cp -p ~/.config/devbox/identities.conf ~/.config/devbox/identities.conf.bak
  exit 0
'

log_info "Syncing ${src} to ${host}:~/.config/devbox/identities.conf..."
rsync -az "${src}" "${host}:.config/devbox/identities.conf"

# Applying it is bootstrap's job, and bootstrap is idempotent: re-running it is
# how the generated files (ssh config, gitconfig includes, allowed_signers, the
# agent gitconfigs) catch up with the file that just landed.
log_info 'Re-running bootstrap in the container...'
if ssh "${host}" 'bash /opt/devbox/container/bootstrap.sh'; then
  log_success "Identity registry synced and applied on ${host}."
else
  log_warn "Registry copied, but bootstrap failed on ${host} - run './bin/devbox bootstrap' on the workstation and read its output."
  exit 1
fi
