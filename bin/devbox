  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
    --help | -h)
      completion_blocked_flags["--help"]=1
      shift
      ;;
    --check)
      completion_blocked_flags["--check"]=1

      shift
      ;;
    *)
      return
      ;;
    esac
  done

  if [[ $completion_current == -* ]]; then
    completion_flag_candidates --help "$completion_current" --help -h
    completion_flag_candidates --check "$completion_current" --check
  fi

}

devbox_deploy_completion() {
  local completion_current="$1"
  local completion_arg_index=0
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
    --help | -h)
      completion_blocked_flags["--help"]=1
      shift
      ;;
    --up)
      completion_blocked_flags["--up"]=1

      shift
      ;;
    --force | -f)
      completion_blocked_flags["--force"]=1

      shift
      ;;
    *)
      if [[ $completion_arg_index -ge 1 ]]; then
        return
      fi
      completion_arg_index=$((completion_arg_index + 1))
      shift

      ;;
    esac
  done

  if [[ $completion_current == -* ]]; then
    completion_flag_candidates --help "$completion_current" --help -h
    completion_flag_candidates --up "$completion_current" --up
    completion_flag_candidates --force "$completion_current" --force -f
  fi

  if [[ $completion_current != -* ]]; then
    case "$completion_arg_index" in
    0)
      if completion_output="$({ completion_ssh_hosts; } 2>/dev/null)"; then
        completion_dynamic_candidates "$completion_current" "$completion_output"
      fi
      ;;
    esac
  fi

}

devbox_sync_completion() {
  local completion_current="$1"
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
    omp)
      shift
      devbox_sync_omp_completion "$completion_current" "$@"
      return
      ;;
    identities)
      shift
      devbox_sync_identities_completion "$completion_current" "$@"
      return
      ;;
    --help | -h)
      completion_blocked_flags["--help"]=1
      shift
      ;;
    *)
      return
      ;;
    esac
  done
  completion_candidates "$completion_current" omp identities

  if [[ $completion_current == -* ]]; then
    completion_flag_candidates --help "$completion_current" --help -h
  fi

}

devbox_sync_omp_completion() {
  local completion_current="$1"
  local completion_arg_index=0
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
    --help | -h)
      completion_blocked_flags["--help"]=1
      shift
      ;;
    --allow-unguarded)
      completion_blocked_flags["--allow-unguarded"]=1

      shift
      ;;
    *)
      if [[ $completion_arg_index -ge 1 ]]; then
        return
      fi
      completion_arg_index=$((completion_arg_index + 1))
      shift

      ;;
    esac
  done

  if [[ $completion_current == -* ]]; then
    completion_flag_candidates --help "$completion_current" --help -h
    completion_flag_candidates --allow-unguarded "$completion_current" --allow-unguarded
  fi

  if [[ $completion_current != -* ]]; then
    case "$completion_arg_index" in
    0)
      if completion_output="$({ completion_ssh_hosts; } 2>/dev/null)"; then
        completion_dynamic_candidates "$completion_current" "$completion_output"
      fi
      ;;
    esac
  fi

}

