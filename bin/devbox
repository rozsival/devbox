devbox_doctor_completion() {
  local completion_current="$1"
  local completion_arg_index=0
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
    --help | -h)
      completion_blocked_flags["--help"]=1
      shift
      ;;
    *)
      if [[ $completion_arg_index -ge 1 ]]; then
        return
      fi
      completion_arg_index=$((completion_arg_index + 1))
      shift

      ;;
    esac
  done

  if [[ $completion_current == -* ]]; then
    completion_flag_candidates --help "$completion_current" --help -h
  fi

  if [[ $completion_current != -* ]]; then
    case "$completion_arg_index" in
    0)
      local -a completion_values=(
        "host"
        "laptop"
      )
      completion_candidates "$completion_current" "${completion_values[@]}"
      ;;
    esac
  fi

}

devbox_completions_completion() {
  local completion_current="$1"
  local completion_arg_index=0
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
    --help | -h)
      completion_blocked_flags["--help"]=1
      shift
      ;;
    *)
      if [[ $completion_arg_index -ge 1 ]]; then
        return
      fi
      completion_arg_index=$((completion_arg_index + 1))
      shift

      ;;
    esac
  done

  if [[ $completion_current == -* ]]; then
    completion_flag_candidates --help "$completion_current" --help -h
  fi

  if [[ $completion_current != -* ]]; then
    case "$completion_arg_index" in
    0)
      local -a completion_values=(
        "bash"
        "zsh"
      )
      completion_candidates "$completion_current" "${completion_values[@]}"
      ;;
    esac
  fi

}

initialize() {
  declare -g version="1.0.0"
  set -euo pipefail

  # Runs before any command. bin/devbox is generated into the repo's bin/, so the
  # repo root is one level up from it on both machines - from the real file, since
  # `devbox install` reaches it through a symlink in ~/.local/bin.
  REPO_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
  readonly REPO_ROOT
  readonly ENV_FILE="${REPO_ROOT}/.env"
  readonly ENV_EXAMPLE="${REPO_ROOT}/.env.example"
  readonly TEMPLATE_DIR="${REPO_ROOT}/home"
  readonly SERVICE='devbox'

  # The laptop's install layout - the same one bootstrap creates in the container.
  readonly LIBEXEC_DIR="${HOME}/.local/libexec"
  readonly AGENT_DIR="${LIBEXEC_DIR}/devbox-agent"
  readonly LAUNCHER_DIR="${AGENT_DIR}/launchers"
  readonly BIN_DIR="${HOME}/.local/bin"
  readonly CONFIG_DIR="${HOME}/.config/devbox"
  readonly SSH_DIR="${HOME}/.ssh"

  # `fail` counts instead of exiting, so a doctor or a --check reports everything
  # that is wrong before the exit status says so; CHECK_ONLY turns the provisioning
  # steps into reports.
  failures=0
  CHECK_ONLY='false'

}

run() {

  declare -g long_usage=''
  declare -g -A args=()
  declare -g -a input=()

  normalize_input "$@"
  parse_requirements "${input[@]}"

  case "$action" in
  "env") devbox_env_command ;;
  "up") devbox_up_command ;;
  "down") devbox_down_command ;;
  "rebuild") devbox_rebuild_command ;;
  "bootstrap") devbox_bootstrap_command ;;
  "skills") devbox_skills_command ;;
  "shell") devbox_shell_command ;;
  "sessions") devbox_sessions_command ;;
  "logs") devbox_logs_command ;;
  "hook") devbox_hook_command ;;
  "keys") devbox_keys_command ;;
  "docker") devbox_docker_command ;;
  "docker setup") devbox_docker_setup_command ;;
  "deploy") devbox_deploy_command ;;
  "sync") devbox_sync_command ;;
  "sync omp") devbox_sync_omp_command ;;
  "sync identities") devbox_sync_identities_command ;;
  "agent") devbox_agent_command ;;
  "agent install") devbox_agent_install_command ;;
  "install") devbox_install_command ;;
  "doctor") devbox_doctor_command ;;
  "completions") devbox_completions_command ;;
  esac
}

start() {
  if [[ ${1:-} == "__complete" ]]; then
    completion_run "${@:2}"
    return
  fi

  command_line_args=("$@")
  initialize
  run "${command_line_args[@]}"
}

start "$@"
