devbox_docker_setup_parse_requirements() {
  local key

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
    --help | -h)
      long_usage=yes
      devbox_docker_setup_usage
      exit
      ;;

    *)
      break
      ;;

    esac
  done

  action="docker setup"

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

    --check)

      args['--check']=1
      shift
      ;;

    --)
      shift
      while [[ $# -gt 0 ]]; do
        key="$1"

        printf "invalid argument: %s\n" "$key" >&2
        exit 1

      done
      break
      ;;

    -?*)
      printf "invalid option: %s\n" "$key" >&2
      exit 1
      ;;

    *)

      printf "invalid argument: %s\n" "$key" >&2
      exit 1

      ;;

    esac
  done

  filter_error=$(filter_host)
  if [[ -n $filter_error ]]; then
    echo "$filter_error" >&2
    exit 1
  fi

}

devbox_deploy_parse_requirements() {
  local key

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
    --help | -h)
      long_usage=yes
      devbox_deploy_usage
      exit
      ;;

    *)
      break
      ;;

    esac
  done

  export DEVBOX_REMOTE_PATH="${DEVBOX_REMOTE_PATH:-~/devbox}"

  missing_deps=

  if ! command -v rsync >/dev/null 2>&1; then
    printf "missing dependency: rsync\n" >&2
    printf "%s\n\n" "brew install rsync" >&2
    missing_deps=1
  fi

  if ! command -v ssh >/dev/null 2>&1; then
    printf "missing dependency: ssh\n" >&2
    missing_deps=1
  fi

  if [[ -n $missing_deps ]]; then
    exit 1
  fi

  action="deploy"

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

    --up)

      args['--up']=1
      shift
      ;;

    --force | -f)

      args['--force']=1
      shift
      ;;

    --)
      shift
      while [[ $# -gt 0 ]]; do
        key="$1"

        if [[ -z ${args['host']+x} ]]; then
          args['host']=$1
          shift
        else
          printf "invalid argument: %s\n" "$key" >&2
          exit 1
        fi

      done
      break
      ;;

    -?*)
      printf "invalid option: %s\n" "$key" >&2
      exit 1
      ;;

    *)

      if [[ -z ${args['host']+x} ]]; then
        args['host']=$1
        shift
      else
        printf "invalid argument: %s\n" "$key" >&2
        exit 1
      fi

      ;;

    esac
  done

  if [[ -n ${args['--force']+x} ]] && [[ -z "${args[--up]:-}" ]]; then
    printf "%s\n" "--force needs --up" >&2
    exit 1
  fi

  filter_error=$(filter_laptop)
  if [[ -n $filter_error ]]; then
    echo "$filter_error" >&2
    exit 1
  fi

}

