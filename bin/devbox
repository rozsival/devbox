devbox_usage() {
  if [[ -n $long_usage ]]; then
    printf "devbox\n\n"
    printf "  Manage the devbox from the workstation that runs it and the laptop that\n  deploys to it\n  \n  Workstation commands refuse to run on the laptop and vice versa.\n\n"
  else
    printf "devbox - Manage the devbox from the workstation that runs it and the laptop that deploys to it\n\n"
  fi

  printf "%s\n" "Usage:"
  printf "  devbox COMMAND\n"
  printf "  devbox [COMMAND] --help | -h\n"
  printf "  devbox --version | -v\n"
  echo

  printf "%s\n" "Workstation Commands:"
  printf "  %s   Create .env from .env.example and sync BIND_ADDR, HOST_UID and HOST_GID\n" "env            "
  printf "  %s   Preflight, then build and start the container\n" "up             "
  printf "  %s   Stop and remove the container\n" "down           "
  printf "  %s   Rebuild the image from scratch and restart\n" "rebuild        "
  printf "  %s   Re-run the in-container user setup\n" "bootstrap      "
  printf "  %s   Install the optional agent skills and agent-browser\n" "skills         "
  printf "  %s   Open a login shell inside the container\n" "shell          "
  printf "  %s   List the SSH sessions connected to the container\n" "sessions       "
  printf "  %s   Show the container logs (last 100 lines)\n" "logs           "
  printf "  %s   Restart the moshi-hook daemon in place, without touching SSH sessions\n" "hook           "
  printf "  %s   Print the installed identity public keys and the sshd host-key fingerprint\n" "keys           "
  printf "  %s   The rootless project Docker daemon\n" "docker         "
  printf "  %s   Provision the rootless project Docker daemon (needs sudo)\n" "docker setup   "
  echo
  printf "%s\n" "Laptop Commands:"
  printf "  %s   Sync this repo to the workstation, optionally bringing the container up\n" "deploy         "
  printf "  %s   Copy laptop configuration into the devbox container\n" "sync           "
  printf "  %s   Copy the laptop's OMP preset into the devbox\n" "sync omp       "
  printf "  %s   Copy the laptop's identity registry into the devbox and apply it\n" "sync identities"
  printf "  %s   The agent git override on this laptop\n" "agent          "
  printf "  %s   Install the agent git override on this laptop\n" "agent install  "
  echo
  printf "%s\n" "Both Commands:"
  printf "  %s   Put devbox on this machine's PATH, with bash completion\n" "install        "
  printf "  %s   Check this machine's side of the devbox\n" "doctor         "
  printf "  %s   Print the shell completion script for bash or zsh\n" "completions    "
  echo

  if [[ -n "$long_usage" ]]; then

    printf "%s\n" "Options:"

    printf "  %s\n" "--help, -h"
    printf "    Show this help\n"
    echo
    printf "  %s\n" "--version, -v"
    printf "    Show version number\n"
    echo

    printf "See docs/cli.md for the full reference.\n"
    echo

  fi
}

