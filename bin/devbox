    exit 1
    ;;

  esac

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

    --)
      shift
      while [[ $# -gt 0 ]]; do
        key="$1"

        printf "invalid argument: %s\n" "$key" >&2
        exit 1

      done
      break
      ;;

    -?*)
      printf "invalid option: %s\n" "$key" >&2
      exit 1
      ;;

    *)

      printf "invalid argument: %s\n" "$key" >&2
      exit 1

      ;;

    esac
  done

}

