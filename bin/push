#!/usr/bin/env bash
# Laptop-side deploy: sync this repo to the workstation and optionally bring the
# container up. Repeatable by design - `.env` and the data directory are excluded,
# so host-local config survives every push.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly REPO_ROOT

log_info() { echo -e "\033[0;34m[INFO]\033[0m  $*"; }
log_success() { echo -e "\033[0;32m[OK]\033[0m    $*"; }
log_error() {
  echo -e "\033[0;31m[ERROR]\033[0m $*" >&2
  exit 1
}

usage() {
  cat <<'USAGE'
Usage: ./bin/push [host] [--up]

Arguments:
  host    SSH host to deploy to (default: $DEVBOX_HOST, then 'workstation')

Options:
  --up    Run './bin/devbox up' on the host after syncing

Environment:
  DEVBOX_HOST         default SSH host
  DEVBOX_REMOTE_PATH  remote repo path (default: ~/devbox)
USAGE
}

host="${DEVBOX_HOST:-workstation}"
remote_path="${DEVBOX_REMOTE_PATH:-~/devbox}"
run_up=0

for arg in "$@"; do
  case "${arg}" in
  --up) run_up=1 ;;
  -h | --help)
    usage
    exit 0
    ;;
  -*) log_error "Unknown option: ${arg}" ;;
  *) host="${arg}" ;;
  esac
done

command -v rsync >/dev/null 2>&1 || log_error 'rsync is missing locally - run: brew install rsync'
ssh "${host}" 'command -v rsync >/dev/null 2>&1' ||
  log_error "rsync is missing on ${host} - run: ssh ${host} 'sudo apt-get install -y rsync'"

log_info "Syncing ${REPO_ROOT}/ to ${host}:${remote_path}/..."
rsync -az --delete \
  --exclude '.git' \
  --exclude '.env' \
  --exclude 'data/' \
  --exclude '.DS_Store' \
  "${REPO_ROOT}/" "${host}:${remote_path}/"
log_success "Synced to ${host}:${remote_path}."

if ((run_up)); then
  log_info "Bringing the devbox up on ${host}..."
  # shellcheck disable=SC2029 # remote_path is meant to expand locally
  ssh "${host}" "cd ${remote_path} && ./bin/devbox up"
fi
