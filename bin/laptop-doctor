#!/usr/bin/env bash
# Laptop-side: check that this machine matches the layout the devbox expects
# from it - the identity registry, private keys only in 1Password, the named
# public halves in ~/.ssh, ssh and git configured to select through them, the
# agent git override installed and current, the tokens and App credentials it
# needs, and the connections it makes. Read-only; each check reports, and the
# exit status is non-zero if any failed. See .agents/skills/devbox-laptop and
# docs/git.md.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly REPO_ROOT
readonly TEMPLATE_DIR="${REPO_ROOT}/home"
readonly LIBEXEC_DIR="${HOME}/.local/libexec"
readonly AGENT_DIR="${LIBEXEC_DIR}/devbox-agent"
readonly BIN_DIR="${HOME}/.local/bin"
readonly CONFIG_DIR="${HOME}/.config/devbox"
readonly SSH_DIR="${HOME}/.ssh"
readonly OP_AGENT_SOCK="${HOME}/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

# Inside an agent session the launcher points git at agent.gitconfig and the
# SSH fence, and puts the gh shim first on the PATH; this audits your own
# configuration and calls gh with explicit tokens, so undo all of that.
unset GIT_CONFIG_GLOBAL GIT_SSH_COMMAND GIT_TERMINAL_PROMPT GH_CONFIG_DIR
PATH=":${PATH}:"
PATH="${PATH//:${AGENT_DIR}:/:}"
PATH="${PATH#:}"
PATH="${PATH%:}"

# The workstation's SSH alias is per-laptop, so it lives in the same gitignored
# file ./bin/push reads rather than in a second variable of its own: one name,
# one place, or the documented one-liner that sets it up would leave these
# checks silently skipped.
if [[ -f "${REPO_ROOT}/.push.env" ]]; then
  # shellcheck source=/dev/null # per-laptop, not repo content
  . "${REPO_ROOT}/.push.env"
fi
workstation_host="${DEVBOX_HOST:-}"

log_info() { echo -e "\033[0;34m[INFO]\033[0m  $*"; }
log_success() { echo -e "\033[0;32m[OK]\033[0m    $*"; }
log_warn() { echo -e "\033[1;33m[WARN]\033[0m  $*" >&2; }

failures=0
fail() {
  log_warn "$*"
  failures=$((failures + 1))
}

# perl rather than stat: BSD and GNU stat disagree on flags, and both may be on
# a macOS PATH (coreutils' gnubin ahead of /usr/bin).
file_mode() {
  perl -e 'printf "%o\n", (stat $ARGV[0])[2] & 07777' "$1"
}

# -- 0. Identity registry -------------------------------------------------------
# Everything below that names a slug, a directory or a host comes from this
# file; a broken registry must not stop the checks that do not depend on it
# (keys still get checked, the launcher symlinks still get checked), so it is
# read once here and every later section gates its own identity-derived part
# on ${identities_ok} rather than failing outright.
log_info 'identity registry'
identities_lib="${LIBEXEC_DIR}/devbox-identities"
identities_file="${CONFIG_DIR}/identities.conf"
identities_ok=0
slugs=''
default_slug=''
if [[ ! -r ${identities_lib} ]]; then
  fail "${identities_lib} missing - run ./bin/install-agent"
else
  # Sourced, not shelled out to, so every section below can call di_* directly
  # and render a fresh agent gitconfig to compare against what is installed.
  # shellcheck source=../home/.local/libexec/devbox-identities
  . "${identities_lib}"
  if ! di_check; then
    fail "${identities_file} is not usable - the identity-derived checks below are skipped"
  else
    identities_ok=1
    slugs="$(di_slugs)"
    default_slug="$(di_default)"
    log_success "${identities_file} valid: $(tr '\n' ' ' <<<"${slugs}") (default: ${default_slug})"
  fi
fi

# -- 1. Private keys: none on disk, all in 1Password --------------------------
log_info 'Keys'
private_on_disk=()
for f in "${SSH_DIR}"/*; do
  [[ -f ${f} ]] || continue
  if head -c 40 "${f}" 2>/dev/null | grep -q 'PRIVATE KEY'; then
    private_on_disk+=("${f##*/}")
  fi
done
if ((${#private_on_disk[@]})); then
  fail "private key(s) on disk: ${private_on_disk[*]} - 1Password is the only key store; delete them once the item exists there"
else
  log_success 'no private key on disk'
fi

if [[ -S ${OP_AGENT_SOCK} ]] && agent_keys="$(SSH_AUTH_SOCK="${OP_AGENT_SOCK}" ssh-add -l 2>/dev/null)"; then
  log_success "1Password SSH agent up, $(wc -l <<<"${agent_keys}" | tr -d ' ') keys"
else
  agent_keys=''
  fail '1Password SSH agent not reachable (1Password → Developer → SSH agent, and unlock)'
fi

pub_list=()
if ((identities_ok)); then
  for slug in ${slugs}; do
    pub_list+=("id_${slug}" "signing_${slug}")
  done
fi
pub_list+=(devbox)
for pub in "${pub_list[@]}"; do
  file="${SSH_DIR}/${pub}.pub"
  if [[ ! -f ${file} ]]; then
    fail "${file} missing"
    continue
  fi
  fingerprint="$(ssh-keygen -lf "${file}" 2>/dev/null | cut -d' ' -f2 || true)"
  if [[ -z ${fingerprint} ]]; then
    fail "${file} is not a public key"
  elif [[ -n ${agent_keys} ]] && ! grep -q "${fingerprint}" <<<"${agent_keys}"; then
    fail "${pub}.pub (${fingerprint}) is not held by the 1Password agent"
  else
    log_success "${pub}.pub ${fingerprint}"
  fi
done

# -- 2. ssh config: every host selects one public key through the agent ------
log_info 'ssh config'
# A config that does not parse kills every ssh client before it reaches the agent - herdr then reports
# "connection was lost" and 1Password never prompts. Name that once instead of failing every host below.
if ! config_err="$(ssh -G localhost 2>&1 >/dev/null)"; then
  # shellcheck disable=SC2088  # literal ~ in a message
  fail "~/.ssh/config does not parse: ${config_err//$'\n'/; }"
fi
# `tag` is what git passes as `ssh -P <tag>` for an identity's orgs; empty for
# a plain connection.
check_host() {
  local host="$1" tag="$2" label resolved agent_cfg only files pub
  shift 2
  label="Host ${host}${tag:+ tagged ${tag}}"
  resolved="$(ssh ${tag:+-P "${tag}"} -G "${host}" 2>/dev/null)" || {
    fail "ssh -G ${host} failed"
    return
  }
  agent_cfg="$(sed -n 's/^identityagent //p' <<<"${resolved}")"
  only="$(sed -n 's/^identitiesonly //p' <<<"${resolved}")"
  files="$(sed -n 's/^identityfile //p' <<<"${resolved}")"
  files="${files//\~/${HOME}}"
  if [[ ${agent_cfg} != *1password* ]]; then
    fail "${label}: IdentityAgent is not the 1Password socket (${agent_cfg:-unset})"
    return
  elif [[ ${only} != yes ]]; then
    fail "${label}: IdentitiesOnly is not yes"
    return
  fi
  for pub in "$@"; do
    if [[ ${files} == "${SSH_DIR}/${pub}.pub" ]]; then
      log_success "${label} → ${pub}.pub via 1Password"
      return
    fi
  done
  # shellcheck disable=SC2088  # literal ~ in a message
  fail "${label}: IdentityFile is '${files//$'\n'/, }', expected exactly one of: $(printf '~/.ssh/%s.pub ' "$@")"
}
if ((identities_ok)); then
  # Per forge host: the plain connection gets the host's default key, and each
  # tag exactly its identity's - one IdentityFile each, since ssh tries the
  # listed keys in the agent's order, not the order they are written in.
  for host in $(for slug in ${slugs}; do di_get "${slug}" host; done | sort -u); do
    check_host "${host}" '' "id_$(di_host_default "${host}")"
    for slug in ${slugs}; do
      tag="$(di_get "${slug}" tag)"
      [[ -n ${tag} && "$(di_get "${slug}" host)" == "${host}" ]] || continue
      check_host "${host}" "${tag}" "id_${slug}"
    done
    for slug in ${slugs}; do
      if grep -Eqi "^[[:space:]]*Host[[:space:]].*(^|[[:space:]])${slug}\.${host//./\\.}([[:space:]]|$)" "${SSH_DIR}/config" 2>/dev/null; then
        # shellcheck disable=SC2088  # literal ~ in a message
        fail "~/.ssh/config still has the alias Host ${slug}.${host} - aliases are gone; delete the block (the tag selects the key)"
      fi
    done
  done
fi
# Not identity-derived: no slug names the workstation, so it comes from
# DEVBOX_HOST (env or .push.env) rather than a hard-coded hostname in a repo
# meant to go public.
if [[ -n ${workstation_host} ]]; then
  if ((identities_ok)); then
    check_host "${workstation_host}" '' devbox "id_${default_slug}"
  else
    check_host "${workstation_host}" '' devbox
  fi
else
  log_info 'DEVBOX_HOST not set (env or .push.env) - skipping the Host <workstation> ssh config check'
fi
check_host devbox '' devbox
if [[ "$(ssh -G devbox 2>/dev/null | sed -n 's/^forwardagent //p')" == yes ]]; then
  fail 'Host devbox: ForwardAgent yes - herdr would carry your agent into every session; forward explicitly with ssh -A instead'
fi

# -- 3. git: sign with the account signing key, through op-ssh-sign ----------
log_info 'git config'
check_git() {
  local label="$1" expect="$2" actual="$3"
  if [[ ${actual} == "${expect}" ]]; then
    log_success "${label} = ${actual}"
  else
    fail "${label} is '${actual:-unset}', expected '${expect}'"
  fi
}
check_git 'gpg.format' ssh "$(git config --global gpg.format || true)"
check_git 'gpg.ssh.program' /Applications/1Password.app/Contents/MacOS/op-ssh-sign "$(git config --global gpg.ssh.program || true)"
check_git 'commit.gpgsign' true "$(git config --global commit.gpgsign || true)"
check_git 'gpg.ssh.allowedSignersFile' "${SSH_DIR}/allowed_signers" "$(git config --global gpg.ssh.allowedSignersFile || true)"
if ((identities_ok)); then
  check_git 'user.signingkey' "${SSH_DIR}/signing_${default_slug}.pub" "$(git config --global user.signingkey || true)"
  for slug in ${slugs}; do
    [[ ${slug} != "${default_slug}" ]] || continue
    # The literal ~ form, not the expanded one: this is hand-written in
    # ~/.gitconfig, and git's own includeIf gitdir: matching is what expands it.
    dir_raw="$(di_raw "${slug}" dir)"
    while [[ ${dir_raw} == */ && ${dir_raw} != / ]]; do dir_raw="${dir_raw%/}"; done
    include_cfg="$(git config --global "includeIf.gitdir:${dir_raw}/.path" || true)"
    if [[ -z ${include_cfg} ]]; then
      # shellcheck disable=SC2088  # literal ~ in a message
      fail "includeIf gitdir:${dir_raw}/ is not configured in ~/.gitconfig"
    else
      include_file="${include_cfg/#\~/${HOME}}"
      check_git "[${slug}] user.signingkey" "${SSH_DIR}/signing_${slug}.pub" "$(git config --file "${include_file}" user.signingkey || true)"
      if git config --file "${include_file}" --get-regexp '^url\..*\.insteadof$' >/dev/null 2>&1; then
        fail "${include_file} still rewrites remote URLs (url.*.insteadOf) - aliases are gone; replace it with: devbox-identities render user-gitconfig ${slug}"
      fi
    fi
  done
  # Per GitHub owner: a probe remote in each URL form, evaluated from / so no
  # `gitdir:` include interferes - exactly what a first `git clone` sees.
  for slug in ${slugs}; do
    tag="$(di_get "${slug}" tag)"
    while IFS= read -r pattern; do
      probe="${pattern%\*\*}probe.git"
      got_email="$(git -C / -c "remote.origin.url=${probe}" config user.email || true)"
      got_key="$(git -C / -c "remote.origin.url=${probe}" config user.signingkey || true)"
      got_ssh="$(git -C / -c "remote.origin.url=${probe}" config core.sshCommand || true)"
      if [[ ${got_email} == "$(di_get "${slug}" email)" && ${got_key} == "${SSH_DIR}/signing_${slug}.pub" &&
      ${got_ssh} == "${tag:+ssh -P ${tag}}" ]]; then
        log_success "[${slug}] ${pattern} → ${got_email}${tag:+, ssh -P ${tag}}"
      else
        fail "[${slug}] a ${pattern} remote gets '${got_email:-no email}', '${got_key:-no signing key}', '${got_ssh:-no sshCommand}' - add includeIf \"hasconfig:remote.*.url:${pattern}\" to ~/.gitconfig with path = a file holding: devbox-identities render org-gitconfig ${slug}"
      fi
    done < <(di_org_urls "${slug}")
  done
  stale_remotes="$(di_alias_remotes)"
  if [[ -n ${stale_remotes} ]]; then
    fail "clones still on an SSH alias (nothing resolves those now): $(awk '{printf "%sgit -C %s remote set-url %s %s", sep, $1, $2, $3; sep = "; "}' <<<"${stale_remotes}")"
  fi
  signing_keys_on_disk=0
  for slug in ${slugs}; do
    [[ -f "${SSH_DIR}/signing_${slug}.pub" ]] || continue
    signing_keys_on_disk=$((signing_keys_on_disk + 1))
  done
  if [[ -f ${SSH_DIR}/allowed_signers ]] && (($(grep -c . "${SSH_DIR}/allowed_signers") >= signing_keys_on_disk)); then
    log_success "allowed_signers lists ${signing_keys_on_disk} identit$([[ ${signing_keys_on_disk} == 1 ]] && echo y || echo ies)"
  else
    fail "${SSH_DIR}/allowed_signers missing or incomplete (one line per identity with a signing key on disk: <email> <key type> <key>)"
  fi
else
  log_warn 'identity registry unusable - skipping user.signingkey, includeIf and allowed_signers checks'
fi

# -- 4. Agent git override: installed and identical to the templates ---------
log_info 'agent git override'
if resolved="$(command -v omp 2>/dev/null)" && [[ "$(readlink -f "${resolved}")" == "${AGENT_DIR}/omp-launcher" ]]; then
  log_success "omp → ${resolved} → launcher"
else
  fail "omp resolves to ${resolved:-nothing}, not the launcher - run ./bin/install-agent and put ~/.local/bin first on the PATH"
fi
# Both hops must stay symlinks. A plain file named `omp` on the PATH is what
# `omp update` takes over in place: that is how a release binary once landed on
# top of the launcher, leaving agent sessions on your own gitconfig and SSH keys.
for link in "${AGENT_DIR}/omp" "${BIN_DIR}/omp"; do
  [[ -L ${link} ]] || fail "${link} is not a symlink to ${AGENT_DIR}/omp-launcher - an omp release binary may have replaced it; run ./bin/install-agent"
done
# The reader is installed in libexec and reached by name through ~/.local/bin,
# because that is the only one of the two the shells put on the PATH - and every
# checklist, doc and `doctor` message tells people to run `devbox-identities
# check`.
reader_link="${BIN_DIR}/devbox-identities"
if [[ ! -L ${reader_link} ]]; then
  fail "${reader_link} is not a symlink to ${identities_lib} - 'devbox-identities' will not resolve by name; run ./bin/install-agent"
elif [[ "$(readlink -f "${reader_link}")" != "$(readlink -f "${identities_lib}")" ]]; then
  fail "${reader_link} points at $(readlink "${reader_link}"), not ${identities_lib}; run ./bin/install-agent"
else
  log_success 'devbox-identities resolves by name through ~/.local/bin'
fi
stale=()
for rel in .local/libexec/devbox-agent/omp-launcher .local/libexec/devbox-agent/gh .local/libexec/devbox-agent/devbox-git-credential \
  .local/libexec/devbox-agent/devbox-git-no-ssh .local/bin/devbox-gh-token .local/libexec/devbox-identities; do
  cmp -s "${TEMPLATE_DIR}/${rel}" "${HOME}/${rel}" || stale+=("${HOME}/${rel}")
done
git_config_dir="${CONFIG_DIR}/git"
if ((identities_ok)); then
  # Rendered, not copied, so drift is checked against a fresh render rather
  # than a template file that no longer exists on disk.
  rendered_root="$(mktemp)"
  DEVBOX_IDENTITIES_TEMPLATE_DIR="${TEMPLATE_DIR}/.config/devbox/git" di_render_agent_gitconfig >"${rendered_root}"
  cmp -s "${rendered_root}" "${git_config_dir}/agent.gitconfig" || stale+=("${git_config_dir}/agent.gitconfig")
  rm -f "${rendered_root}"
  expected_agent_configs=()
  # Every identity that claims a tree: that is what bootstrap and install-agent
  # render, because git applies every matching include and a nested tree would
  # otherwise inherit the outer identity's author.
  for slug in $(di_dir_slugs); do
    expected_agent_configs+=("agent-${slug}.gitconfig")
    rendered_slug="$(mktemp)"
    di_render_agent_author "${slug}" >"${rendered_slug}"
    cmp -s "${rendered_slug}" "${git_config_dir}/agent-${slug}.gitconfig" || stale+=("${git_config_dir}/agent-${slug}.gitconfig")
    rm -f "${rendered_slug}"
  done
  # A dropped or renamed identity must not keep claiming a tree through a file
  # install-agent no longer knows to regenerate.
  for f in "${git_config_dir}"/agent-*.gitconfig; do
    [[ -e ${f} ]] || continue
    name="${f##*/}"
    known=0
    for expected in "${expected_agent_configs[@]:-}"; do
      [[ ${name} != "${expected}" ]] || {
        known=1
        break
      }
    done
    ((known)) || stale+=("${f} (no matching identity in ${identities_file})")
  done
else
  log_warn 'identity registry unusable - skipping the agent gitconfig render comparison'
fi
if ((${#stale[@]})); then
  fail "differ from the repo templates: ${stale[*]} - run ./bin/install-agent"
else
  log_success 'launcher, shim, helper, fence, devbox-identities and agent gitconfigs match the repo templates'
fi
# The gitconfigs must also be unwritable, directory included: GIT_CONFIG_GLOBAL
# points in there, so `git config --global` in a session rewrites them - that is
# how the agent author became your own name and email for five commits. git
# locks beside the file it writes, so the directory mode is the one that counts.
if [[ -w ${git_config_dir} ]]; then
  fail "${git_config_dir} is writable - a stray 'git config --global' in a session would rewrite the agent identity; run ./bin/install-agent"
else
  writable_agent_cfg=()
  for f in "${git_config_dir}"/agent*.gitconfig; do
    [[ -e ${f} && -w ${f} ]] && writable_agent_cfg+=("${f}")
  done
  if ((${#writable_agent_cfg[@]})); then
    fail "${writable_agent_cfg[*]} writable - run ./bin/install-agent"
  else
    log_success 'agent gitconfigs read-only (directory 500, files 444)'
  fi
fi
# A file at the pre-move path means something still points there: either
# ./bin/install-agent has not run since the move, or an agent session started
# before it is alive and its login shells keep writing your identity into it.
stale_root_cfg=()
for f in "${CONFIG_DIR}/agent.gitconfig" "${CONFIG_DIR}"/agent-*.gitconfig; do
  [[ -e ${f} ]] && stale_root_cfg+=("${f}")
done
if ((${#stale_root_cfg[@]})); then
  fail "${stale_root_cfg[*]} exists outside the read-only directory - run ./bin/install-agent, then restart any agent session older than it (its GIT_CONFIG_GLOBAL still names the old path)"
fi
# The class of writer that caused this, caught by behaviour rather than by
# grepping one dotfile: a login shell that runs `git config --global …` writes
# into whatever GIT_CONFIG_GLOBAL names, and inside a session that is the
# agent's own configuration. ~/.extra (sourced by ~/.bash_profile) did exactly
# that here, and every login bash a session started re-stamped the author.
# ~/.gitconfig already carries the identity, so such a line is redundant even
# for your own shell. Probe with a throwaway file: a login shell that writes
# nothing leaves it empty. Interactive *and* login (`-ilc`), because ~/.bashrc
# and ~/.zshrc are read only when interactive, and a herdr pane or
# `./bin/devbox shell` inside the fence is exactly an interactive login shell;
# stdin from /dev/null so no prompt framework can block the doctor.
shell_writes=()
for shell in bash zsh; do
  command -v "${shell}" >/dev/null 2>&1 || continue
  probe="$(mktemp)"
  GIT_CONFIG_GLOBAL="${probe}" "${shell}" -ilc true </dev/null >/dev/null 2>&1 || true
  if [[ -s ${probe} ]]; then
    shell_writes+=("${shell} ($(git config --file "${probe}" --list 2>/dev/null | tr '\n' ' '))")
  fi
  rm -f "${probe}"
done
if ((${#shell_writes[@]})); then
  log_warn "a login shell writes global git config: ${shell_writes[*]} - in an agent session that targets ${git_config_dir}/agent.gitconfig, which is why it is read-only now (the write fails loudly there). Remove the 'git config --global' lines from your dotfiles; ~/.gitconfig already holds your identity"
else
  log_success 'no login shell writes into the agent gitconfig'
fi
# The tokens the helper mints are used with username x-access-token; if one is
# in the macOS keychain, a system credential helper ran ahead of ours in an
# agent session and stored it. Your own gh login uses your handle, never this.
if printf 'protocol=https\nhost=github.com\nusername=x-access-token\n\n' | git credential-osxkeychain get 2>/dev/null | grep -q '^password='; then
  fail 'the keychain holds an agent token for github.com (username x-access-token): a system credential helper ran ahead of devbox-git-credential - erase it with git credential-osxkeychain erase and check git config --show-origin --get-all credential.helper'
else
  log_success 'no agent token in the macOS keychain'
fi

# -- 5. What the helper needs: tokens and App credentials --------------------
log_info 'credentials'
secrets_file="${CONFIG_DIR}/secrets.env"
if [[ ! -f ${secrets_file} ]]; then
  fail "${secrets_file} missing - run ./bin/install-agent"
elif [[ "$(file_mode "${secrets_file}")" != 600 ]]; then
  fail "${secrets_file} is not mode 600"
else
  log_success "${secrets_file} present, mode 600"
fi
if ((identities_ok)); then
  for slug in ${slugs}; do
    dir="$(di_get "${slug}" dir)"
    if ! token="$("${HOME}/.local/bin/devbox-gh-token" "${dir:-${HOME}}" 2>/dev/null)" || [[ -z ${token} ]]; then
      fail "no ${slug} token: set $(di_get "${slug}" token_var) in ${secrets_file} (fine-grained; contents write on repos agents push without the App)"
    elif ! GH_TOKEN="${token}" GH_CONFIG_DIR="${CONFIG_DIR}/gh" timeout 15 gh auth status >/dev/null 2>&1; then
      fail "the ${slug} token is rejected by gh - expired, revoked, or GitHub unreachable"
    else
      log_success "${slug} token accepted by gh"
    fi
    app_dir="$(di_get "${slug}" app)"
    [[ -n ${app_dir} ]] || continue
    if [[ -r ${app_dir}/app-id && -r ${app_dir}/app.pem ]]; then
      if [[ "$(file_mode "${app_dir}/app.pem")" != 600 ]]; then
        fail "${app_dir}/app.pem is not mode 600"
      elif openssl pkey -in "${app_dir}/app.pem" -noout >/dev/null 2>&1; then
        log_success "${slug} App credentials present (app-id $(tr -d '[:space:]' <"${app_dir}/app-id"))"
      else
        fail "${app_dir}/app.pem is not a readable private key"
      fi
    else
      log_warn "no App credentials in ${app_dir} - ${slug} repositories are pushed with the PAT until app-id + app.pem (mode 600) are there"
    fi
  done
else
  log_warn 'identity registry unusable - skipping per-identity token and App-credential checks'
fi

# -- 6. Connections ------------------------------------------------------------
log_info 'connections'
# Which login answers is only informative; the check is that every identity's
# connection - `ssh -P <tag>` where it has a key of its own, plain otherwise -
# authenticates, and that two identities on the same forge reach two
# *different* accounts, which is what their separate keys exist for - unless
# the registry gives both the same pubkey, which declares one account
# deliberately split by directory (e.g. a private org needing its own PAT).
github_login() {
  ssh ${2:+-P "$2"} -o BatchMode=yes -o ConnectTimeout=10 -T "git@$1" 2>&1 | sed -n 's/^Hi \([^!]*\)!.*/\1/p' || true
}
if ((identities_ok)); then
  conn_slugs=() conn_hosts=() conn_logins=() conn_pubkeys=()
  for slug in ${slugs}; do
    host="$(di_get "${slug}" host)"
    tag="$(di_get "${slug}" tag)"
    label="git@${host}${tag:+ (ssh -P ${tag})}"
    login="$(github_login "${host}" "${tag}")"
    conn_slugs+=("${slug}")
    conn_hosts+=("${host}")
    conn_logins+=("${login}")
    conn_pubkeys+=("$(di_get "${slug}" pubkey)")
    if [[ -n ${login} ]]; then
      log_success "[${slug}] ${label} → ${login}"
    else
      fail "[${slug}] ${label} did not authenticate"
    fi
  done
  conn_count=${#conn_slugs[@]}
  for ((i = 0; i < conn_count; i++)); do
    for ((j = i + 1; j < conn_count; j++)); do
      [[ ${conn_hosts[i]} == "${conn_hosts[j]}" ]] || continue
      [[ -n ${conn_logins[i]} && ${conn_logins[i]} == "${conn_logins[j]}" ]] || continue
      [[ -z ${conn_pubkeys[i]} || ${conn_pubkeys[i]} != "${conn_pubkeys[j]}" ]] || continue
      fail "[${conn_slugs[i]}] and [${conn_slugs[j]}] both reach ${conn_logins[i]} on ${conn_hosts[i]} - the ssh config offers the wrong key for one of them (ssh -G -P <slug> ${conn_hosts[i]})"
    done
  done
else
  log_warn 'identity registry unusable - skipping per-identity connection checks'
fi
if [[ -n ${workstation_host} ]]; then
  if ssh -o BatchMode=yes -o ConnectTimeout=10 "${workstation_host}" true 2>/dev/null; then
    log_success "ssh ${workstation_host}"
  else
    fail "ssh ${workstation_host} failed - is 1Password unlocked and the Devbox Laptop key approved?"
  fi
else
  log_info 'DEVBOX_HOST not set (env or .push.env) - skipping ssh reachability check for the workstation'
fi
if ssh -o BatchMode=yes -o ConnectTimeout=10 devbox true 2>/dev/null; then
  log_success 'ssh devbox'
else
  fail 'ssh devbox failed - is 1Password unlocked and the Devbox Laptop key approved?'
fi

echo
if ((failures)); then
  log_warn "${failures} check(s) failed."
  exit 1
fi
log_success 'All checks passed.'
