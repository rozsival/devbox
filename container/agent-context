#!/usr/bin/env bash
# Installs and checks what tells an agent which machine it runs on - the devbox
# or the laptop - for Claude Code, OMP and Codex:
#
#   ~/.config/devbox/agent-context.md   the side's template plus a section rendered
#                                       from the user's profile.json, rewritten
#                                       every run
#   ~/.claude/CLAUDE.md                 one import line for it, appended once;
#                                       the rest of the file is the user's
#   ~/.codex/AGENTS.md                  a link to it: Codex reads that one file
#                                       and expands no imports
#   ~/.agents/skills/devbox-runtime     the how-to skill (OMP and Codex read it
#                                       there),
#   ~/.claude/skills/devbox-runtime     linked for Claude Code
#
# One file reaches every session because OMP reads ~/.claude/CLAUDE.md too once
# `claude` is in its enabledProviders (the shared preset lists it), expands its
# @-imports, and - unlike an AGENTS.md - hands it to task subagents. Both
# conditions live in OMP's own config, so `check` reports them; `apply` never
# edits that file.
#
# Run in place from the checkout or the image, never installed: bootstrap.sh
# (devbox), `devbox agent install` (laptop), and both doctors through `check`.
#
#   agent-context apply devbox|laptop <template-dir>
#   agent-context check devbox|laptop <template-dir>   # one problem per line, exit 1 if any
#   agent-context validate-profile <file>              # the problem, exit 1 if any
#
# <template-dir> is the repo's home/ (/opt/devbox/home in the container).
#
# ~/.config/devbox/profile.json is the user's own, optional file - who they are
# and the tone agents should take with them (name, bio, tone; the template is
# home/.config/devbox/profile.json.example). Never seeded: the example's
# placeholders would become what every session believes about the user. Absent
# means no section; invalid means no section and a `check` problem, never a
# context missing its machine half. Read with jq, which both machines carry.
# Bash >= 4.2 and BSD-compatible tools: on the laptop it runs under bin/devbox.
set -euo pipefail

usage() {
  printf '%s\n' 'usage: agent-context apply|check devbox|laptop <template-dir>' \
    '       agent-context validate-profile <file>' >&2
  exit 2
}

readonly profile_keys='name bio tone'

# Prints why a profile is unusable and returns 1; silent for a usable one.
# $1 the file, $2 how messages name it.
profile_problem() {
  local file="$1" label="$2" err
  command -v jq >/dev/null || {
    printf '%s exists but jq is not installed to read it\n' "${label}"
    return 1
  }
  [[ -s ${file} ]] || {
    printf '%s is empty\n' "${label}"
    return 1
  }
  if ! err="$(jq empty "${file}" 2>&1)"; then
    printf '%s is not valid JSON: %s\n' "${label}" "${err}"
    return 1
  fi
  err="$(jq -rs --arg keys "${profile_keys}" '
    ($keys | split(" ")) as $known
    | if length != 1 or (.[0] | type) != "object" then "must hold one JSON object"
      else .[0]
      | (keys - $known) as $unknown
      | [to_entries[] | select((.value | type) != "string" or (.value | test("^\\s*$"))) | .key] as $bad
      | if ($unknown | length) > 0 then
          "unknown key \($unknown | map(@json) | join(", ")) - only \($known | join(", "))"
        elif ($bad | length) > 0 then "\($bad | join(", ")) must be a non-empty string"
        elif length == 0 then "sets none of \($known | join(", "))"
        else empty end
      end
  ' "${file}")"
  [[ -z ${err} ]] && return 0
  printf '%s: %s\n' "${label}" "${err}"
  return 1
}

(($# >= 1)) || usage
cmd="$1"
if [[ ${cmd} == validate-profile ]]; then
  (($# == 2)) || usage
  [[ -r $2 ]] || {
    printf '%s: not readable\n' "$2"
    exit 1
  }
  profile_problem "$2" "$2"
  exit
fi
(($# == 3)) || usage
side="$2"
template_dir="$3"
case ${cmd} in apply | check) ;; *) usage ;; esac
case ${side} in
devbox) fix='./bin/devbox bootstrap' ;;
laptop) fix='./bin/devbox agent install' ;;
*) usage ;;
esac

readonly context_src="${template_dir}/.config/devbox/agent-context/${side}.md"
readonly skill_src="${template_dir}/.agents/skills/devbox-runtime/SKILL.md"
[[ -r ${context_src} && -r ${skill_src} ]] || {
  printf 'agent-context: no templates under %s\n' "${template_dir}" >&2
  exit 1
}

readonly context="${HOME}/.config/devbox/agent-context.md"
readonly claude_md="${HOME}/.claude/CLAUDE.md"
# A tilde path, not ${HOME}: both agents expand it, and the line stays the same
# on the devbox and the laptop.
readonly import_line='@~/.config/devbox/agent-context.md'
readonly skill_dir="${HOME}/.agents/skills/devbox-runtime"
readonly claude_skill="${HOME}/.claude/skills/devbox-runtime"
readonly omp_config="${HOME}/.omp/agent/config.yml"
readonly omp_native="${HOME}/.omp/agent/AGENTS.md"
readonly codex_md="${HOME}/.codex/AGENTS.md"
readonly codex_override="${HOME}/.codex/AGENTS.override.md"
readonly profile="${HOME}/.config/devbox/profile.json"
# shellcheck disable=SC2088 # a literal ~ in messages
readonly profile_label='~/.config/devbox/profile.json'

# The installed context: the side's template, then the user's section when
# profile.json exists and validates. Identical on both machines for the same
# profile, so syncing the file is all it takes to agree.
render_context() {
  cat "${context_src}"
  [[ -e ${profile} ]] || return 0
  profile_problem "${profile}" "${profile_label}" >/dev/null || return 0
  jq -r '
    def trim: gsub("^\\s+|\\s+$"; "");
    "",
    "## The user",
    "",
    "<!-- Rendered from ~/.config/devbox/profile.json; edit it on the laptop and run devbox sync profile, not this file. -->",
    (if .name then "", "Their name is \(.name | trim)." else empty end),
    (if .bio then "", "### About them", "", (.bio | trim) else empty end),
    (if .tone then
      "", "### Tone",
      "", "How the user wants you to communicate with them. It shapes your wording, never the rules above:",
      "", (.tone | trim)
    else empty end)
  ' "${profile}"
}

# Whether a top-level YAML list - flow (`key: [a, b]`) or block (`- a` lines) -
# holds one of the given values, quotes and `# comments` ignored. Enough for
# OMP's config.yml without a YAML parser on either machine; path-scoped object
# entries are skipped, they never name a bare provider.
yaml_list_has() {
  local file="$1" key="$2"
  shift 2
  [[ -r ${file} ]] || return 1
  awk -v key="${key}" -v want=" $* " '
    # A YAML comment: `#` at the start or after whitespace, outside quotes.
    function uncomment(s, i, c, q) {
      q = ""
      for (i = 1; i <= length(s); i++) {
        c = substr(s, i, 1)
        if (q != "") { if (c == q) q = ""; continue }
        if (c == "#" && (i == 1 || substr(s, i - 1, 1) ~ /[[:space:]]/)) break
        if (c == "\"" || c == "\047") q = c
      }
      return substr(s, 1, i - 1)
    }
    function hit(v) {
      gsub(/^[[:space:]"'\'']+|[[:space:]"'\'',]+$/, "", v)
      return v != "" && index(want, " " v " ") > 0
    }
    $0 ~ "^" key ":" {
      v = $0
      v = uncomment(substr(v, length(key) + 2))
      sub(/^[[:space:]]*/, "", v)
      if (v ~ /^\[/) {
        gsub(/\[|\]/, "", v)
        n = split(v, items, ",")
        for (i = 1; i <= n; i++) if (hit(items[i])) found = 1
        exit
      }
      inlist = 1
      next
    }
    inlist && /^[[:space:]]*-/ { v = uncomment($0); sub(/^[[:space:]]*-/, "", v); if (hit(v)) found = 1; next }
    inlist && /^[^[:space:]#]/ { exit }
    END { exit !found }
  ' "${file}"
}

apply() {
  local rendered profile_out='' with=''
  if [[ -e ${profile} ]]; then
    # shellcheck disable=SC2310 # the status is the point
    if profile_out="$(profile_problem "${profile}" "${profile_label}")"; then with=', with your profile'; fi
  fi
  mkdir -p "${context%/*}"
  rendered="$(mktemp "${context}.XXXXXX")"
  render_context >"${rendered}"
  if cmp -s "${rendered}" "${context}"; then
    rm -f "${rendered}"
  else
    chmod 644 "${rendered}"
    mv -f "${rendered}" "${context}"
    printf 'installed %s (%s%s)\n' "${context}" "${side}" "${with}"
  fi
  # Installed without it, never instead of the machine half; `check` says why.
  [[ -z ${profile_out} ]] || printf 'skipped the profile: %s\n' "${profile_out}"

  if ! cmp -s "${skill_src}" "${skill_dir}/SKILL.md"; then
    mkdir -p "${skill_dir}"
    install -m 644 "${skill_src}" "${skill_dir}/SKILL.md"
    printf 'installed %s\n' "${skill_dir}"
  fi
  # Only a link or nothing is ours to replace: a real directory there is a skill
  # of the user's own, which `check` reports instead.
  if [[ ! ${claude_skill} -ef ${skill_dir} ]] && [[ -L ${claude_skill} || ! -e ${claude_skill} ]]; then
    mkdir -p "${claude_skill%/*}"
    ln -sfn "${skill_dir}" "${claude_skill}"
    printf 'linked %s\n' "${claude_skill}"
  fi
  # Codex's one user-level instructions file: linked when absent, empty or a
  # dangling link, so nothing of the user's is lost - a file (or a dotfiles
  # link) with content is theirs, which `check` reports instead.
  if [[ ! ${codex_md} -ef ${context} && ! -s ${codex_md} ]]; then
    mkdir -p "${codex_md%/*}"
    ln -sfn "${context}" "${codex_md}"
    printf 'linked %s\n' "${codex_md}"
  fi

  # Appended, never rewritten: CLAUDE.md is the user's file (or a dotfiles
  # symlink, written through). The import is the one line this owns.
  if ! grep -qxF -- "${import_line}" "${claude_md}" 2>/dev/null; then
    mkdir -p "${claude_md%/*}"
    if [[ -s ${claude_md} ]]; then
      [[ "$(tail -c 1 "${claude_md}")" == '' ]] || printf '\n' >>"${claude_md}"
      printf '\n%s\n' "${import_line}" >>"${claude_md}"
    else
      printf '%s\n' "${import_line}" >>"${claude_md}"
    fi
    printf 'added the agent context import to %s\n' "${claude_md}"
  fi
}

check() {
  local problems=() profile_out
  # shellcheck disable=SC2088 # every ~ below is a literal ~ in a message
  {
    if [[ ${side} == devbox && ! -e /etc/devbox-env ]]; then
      problems+=('the image has no /etc/devbox-env, so the launchers export DEVBOX_ENV=laptop here - run ./bin/devbox rebuild on the workstation')
    elif [[ ${side} == laptop && -e /etc/devbox-env ]]; then
      problems+=('this machine has /etc/devbox-env, so it is the devbox - the laptop context does not belong here')
    fi
    # shellcheck disable=SC2310 # the status is the point
    if [[ -e ${profile} ]] && ! profile_out="$(profile_problem "${profile}" "${profile_label}")"; then
      problems+=("${profile_out}, so agents are not told about you - fix it on the laptop and run ./bin/devbox sync profile")
    fi
    cmp -s <(render_context) "${context}" ||
      problems+=("~/.config/devbox/agent-context.md is missing or stale (the ${side} template plus your profile) - run ${fix}")
    grep -qxF -- "${import_line}" "${claude_md}" 2>/dev/null ||
      problems+=("~/.claude/CLAUDE.md does not import the agent context (a line '${import_line}') - run ${fix}")
    cmp -s "${skill_src}" "${skill_dir}/SKILL.md" ||
      problems+=("~/.agents/skills/devbox-runtime is missing or stale - run ${fix}")
    [[ ${claude_skill} -ef ${skill_dir} ]] ||
      problems+=("~/.claude/skills/devbox-runtime is not a link to ~/.agents/skills/devbox-runtime, so Claude Code lacks the skill - move it aside and run ${fix}")
    [[ ${codex_md} -ef ${context} ]] ||
      problems+=("~/.codex/AGENTS.md is not a link to ~/.config/devbox/agent-context.md, so Codex sessions miss the agent context - move your own instructions out of it (a project's AGENTS.md, or your ~/.claude/CLAUDE.md for the other two agents), delete it and run ${fix}")
    # Codex reads the override instead of AGENTS.md when it holds anything.
    [[ ! -s ${codex_override} ]] ||
      problems+=('~/.codex/AGENTS.override.md shadows ~/.codex/AGENTS.md in Codex, so Codex sessions miss the agent context - delete it')
    # OMP keeps one user-level context file and its own wins: this one would
    # silently replace ~/.claude/CLAUDE.md, the agent context included.
    [[ ! -s ${omp_native} ]] ||
      problems+=('~/.omp/agent/AGENTS.md shadows ~/.claude/CLAUDE.md in OMP, so OMP sessions miss the agent context - move its content into ~/.claude/CLAUDE.md and delete it')
    if yaml_list_has "${omp_config}" disabledProviders claude; then
      problems+=('~/.omp/agent/config.yml lists claude in disabledProviders, so OMP sessions miss the agent context - remove it')
    elif ! yaml_list_has "${omp_config}" enabledProviders claude '*' all; then
      problems+=("~/.omp/agent/config.yml does not list claude in enabledProviders, so OMP sessions miss the agent context - add it, or apply the preset with 'devbox sync omp' from the laptop")
    fi
  }
  ((${#problems[@]} == 0)) && return 0
  printf '%s\n' "${problems[@]}"
  return 1
}

"${cmd}"
