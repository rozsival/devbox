#!/usr/bin/env bash
# Installed by container/bootstrap.sh (devbox) and `devbox agent install` (laptop) -
# edit home/.local/bin/wt-herdr in the repo.
#
# `wt herdr [-n|--no-focus] <branch>`: a new worktree for <branch>, cut from the
# default branch as it is on the remote right now, opened as its own herdr
# workspace and focused - or, with -n/--no-focus, without moving the focused herdr
# pane. This shell never moves. By hand that is: go to main, pull,
# `wt switch -c <branch>`, go back to main, open the worktree in herdr.
#
# worktrunk runs any `wt-<name>` on the PATH as `wt <name>` (a custom
# subcommand). It is a script rather than an `[aliases]` entry so the repo does
# not have to merge into the user's own ~/.config/worktrunk/config.toml.
#
# Refuses, before changing anything, when the default branch's worktree holds
# uncommitted changes (untracked files included), when the pull is not a
# fast-forward, or when not running inside a herdr pane.
# A re-run for a branch that already has a worktree (the herdr step failed last
# time) only opens it; a branch without a worktree is refused.
#
# On the devbox the fetch goes over HTTPS with a token from
# devbox-git-credential (the App installation token, else the read-only PAT) -
# the agent sessions' transport - because the container holds no SSH key: an
# SSH remote works there only while a 1Password agent is forwarded. Only the
# fetch: the merge, the worktree and its hooks keep your own ~/.gitconfig.
#
# bash 3.2 compatible: on the laptop this runs under whatever `env bash` finds.
set -euo pipefail

die() {
  printf 'wt herdr: %s\n' "$*" >&2
  exit 1
}

usage() {
  printf '%s\n' 'usage: wt herdr [-n|--no-focus] <branch>' \
    '  new worktree for <branch> from the freshly pulled default branch, opened in herdr and focused' \
    '  -n, --no-focus  open it without moving the focused herdr pane' >&2
  exit "${1:-2}"
}

focus=--focus
branch=''
while [[ $# -gt 0 ]]; do
  case $1 in
  -h | --help) usage 0 ;;
  -n | --no-focus) focus=--no-focus ;;
  --) shift && break ;;
  -*) usage ;;
  *)
    [[ -z ${branch} ]] || usage
    branch=$1
    ;;
  esac
  shift
done
if [[ $# -gt 0 ]]; then
  [[ -z ${branch} && $# -eq 1 ]] || usage
  branch=$1
fi
[[ -n ${branch} ]] || usage

# Checked first: a worktree that herdr cannot open is the outcome to avoid.
[[ ${HERDR_ENV:-} == 1 ]] || die 'not inside a herdr pane (HERDR_ENV is not 1)'
command -v herdr >/dev/null || die 'herdr is not on the PATH'
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "not inside a git work tree: ${PWD}"

default_branch="$(wt config state default-branch get)" || die 'wt cannot determine the default branch'

# git with the agent gitconfig on the devbox (see the header), for the fetch
# only: its rewrites send every forge remote over HTTPS and its helper,
# `!devbox-git-credential`, answers for them from the PATH - devbox.sh puts its
# directory there, prepended again for a shell that lost it. Plain git elsewhere.
fetch_git() {
  if [[ -e /etc/devbox-env ]]; then
    local agent_dir="${HOME}/.local/libexec/devbox-agent" config="${HOME}/.config/devbox/git/agent.gitconfig"
    [[ -r ${config} ]] || die "${config} is missing - run ./bin/devbox bootstrap"
    PATH="${agent_dir}:${PATH}" GIT_CONFIG_GLOBAL="${config}" GIT_TERMINAL_PROMPT=0 git "$@"
  else
    git "$@"
  fi
}

# Path of the worktree that has refs/heads/<$1> checked out, or of the primary
# checkout (listed first) when $1 is empty; empty when none. `-z` because a
# path may hold a newline, which splits the plain porcelain record. Reads to
# the end rather than returning early, so git never dies of SIGPIPE.
worktree_of() {
  local ref=${1:-} field path='' found=''
  while IFS= read -r -d '' field; do
    [[ -z ${found} ]] || continue
    case ${field} in
    'worktree '*)
      path=${field#worktree }
      [[ -n ${ref} ]] || found=${path}
      ;;
    "branch refs/heads/${ref}") found=${path} ;;
    esac
  done < <(git worktree list --porcelain -z)
  printf '%s' "${found}"
}

# A worktree already holding <branch> is a run whose herdr step failed (or a
# worktree made by hand): open it, nothing more - no pull, no create. A branch
# without a worktree is someone's work; leave it alone.
new_worktree="$(worktree_of "${branch}")"
if [[ -n ${new_worktree} ]]; then
  printf '%s already has a worktree at %s; opening it without pulling\n' "${branch}" "${new_worktree}" >&2
elif git show-ref --verify --quiet "refs/heads/${branch}"; then
  die "branch ${branch} already exists without a worktree; use wt switch ${branch}"
fi

if [[ -z ${new_worktree} ]]; then
  main_worktree="$(worktree_of "${default_branch}")"
  remote="$(git config "branch.${default_branch}.remote")" || die "${default_branch} has no upstream to fetch from"
  merge="$(git config "branch.${default_branch}.merge")" || die "${default_branch} has no upstream to fetch from"
  if [[ -n ${main_worktree} ]]; then
    # Untracked files named explicitly: status.showUntrackedFiles=no would hide
    # them. A failed status is not a clean worktree.
    dirty="$(git -C "${main_worktree}" status --porcelain --untracked-files=normal)" ||
      die "cannot read the status of ${main_worktree}"
    [[ -z ${dirty} ]] ||
      die "${main_worktree} (${default_branch}) has uncommitted changes; commit or stash them first"
    # A pull split in two, so only the fetch takes the devbox transport: the
    # upstream ref lands in FETCH_HEAD, merged under your own configuration.
    printf 'Pulling %s from %s in %s...\n' "${default_branch}" "${remote}" "${main_worktree}" >&2
    fetch_git -C "${main_worktree}" fetch "${remote}" "${merge}"
    git -C "${main_worktree}" merge --ff-only FETCH_HEAD
  else
    # Not checked out anywhere: fast-forward the local branch from its upstream
    # directly. A refspec without `+` refuses a non-fast-forward, like the pull.
    printf 'Fetching %s from %s...\n' "${default_branch}" "${remote}" >&2
    fetch_git fetch "${remote}" "${merge}:refs/heads/${default_branch}"
  fi

  # --no-cd: this shell stays where it is; the worktree's hooks still run.
  wt switch --create "${branch}" --base "${default_branch}" --no-cd

  new_worktree="$(worktree_of "${branch}")"
  [[ -n ${new_worktree} ]] || die "wt switch created no worktree for ${branch}"
fi

# herdr opens a worktree only from the repository's parent workspace - the
# primary checkout, listed first - and creates that one when it is not open,
# whichever workspace this pane happens to be in.
primary_worktree="$(worktree_of '')"
herdr worktree open --cwd "${primary_worktree}" --path "${new_worktree}" "${focus}" >/dev/null
if [[ ${focus} == --focus ]]; then
  printf 'Opened %s in herdr: %s\n' "${branch}" "${new_worktree}" >&2
else
  printf 'Opened %s in herdr (unfocused): %s\n' "${branch}" "${new_worktree}" >&2
fi
