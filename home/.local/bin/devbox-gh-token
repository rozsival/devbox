#!/usr/bin/env bash
# Generated by container/bootstrap.sh - edit home/.local/bin/devbox-gh-token in
# the repo.
#
# Print the GitHub token that belongs to a working directory, on the same rule
# git already uses to pick an identity: ~/projects/work/** is work,
# everything else is personal (docs/git.md). One token per account keeps each
# one fine-grained, expiring and revocable on its own - see docs/secrets.md.
#
#   devbox-gh-token                 # token for $PWD
#   devbox-gh-token ~/projects/x    # token for another directory
#   devbox-gh-token --account       # print `personal` or `work` instead
#
# The `gh` shim next to this file calls it on every invocation, so the account
# follows the directory even when the shell that started the agent was opened
# somewhere else. Anything that reads the token itself - a curl against the API,
# a project script - should do the same: GH_TOKEN=$(devbox-gh-token).
set -euo pipefail

account_only=false
if [[ ${1:-} == --account ]]; then
  account_only=true
  shift
fi

dir="${1:-$PWD}"
# Resolve symlinks: a worktree that only looks like it is under
# ~/projects/work/ must not inherit the work token. A path that does not
# exist keeps its literal form and simply falls through to personal.
dir="$(cd "${dir}" 2>/dev/null && pwd -P || printf '%s' "${dir}")"

# Both spellings of home are matched below: `dir` keeps its literal form when it
# does not exist yet (a path passed before the clone), and comparing that
# against a symlink-resolved $HOME would miss and quietly pick personal.
home_real="$(cd "${HOME:-/home/dev}" 2>/dev/null && pwd -P || printf '%s' "${HOME:-/home/dev}")"
home_literal="${HOME:-/home/dev}"

case "${dir}/" in
"${home_real}/projects/work/"* | "${home_literal}/projects/work/"*)
  account=work
  var=GH_TOKEN_WORK
  ;;
*)
  account=personal
  var=GH_TOKEN_PERSONAL
  ;;
esac

if [[ ${account_only} == true ]]; then
  printf '%s\n' "${account}"
  exit 0
fi

# Resolution order, first hit wins:
#   1. an explicit GH_TOKEN in the environment - a deliberate one-off
#      (`GH_TOKEN=$other gh ...`), and what a pre-split secrets.env still holds
#   2. the account's variable in the environment (a shell that sourced
#      secrets.env through ~/.bashrc.d/devbox.sh)
#   3. the same variable read straight out of secrets.env
#
# Step 3 is what makes this independent of shell startup: a token added to
# secrets.env works in the session that is already open, and the error below is
# then true in every case - the file really is the only place looked at.
if [[ -n ${GH_TOKEN:-} ]]; then
  printf '%s\n' "${GH_TOKEN}"
  exit 0
fi

token="${!var:-}"

secrets_file="${HOME:-/home/dev}/.config/devbox/secrets.env"
if [[ -z ${token} && -r ${secrets_file} ]]; then
  # Read in a subshell so a stray `export`, an unrelated variable or a syntax
  # error in a hand-edited credential file cannot affect this script's own
  # state; only the one value is carried back.
  # `GH_TOKEN` first, mirroring step 1 above: a file that sets both must resolve
  # the same way whether or not the caller's shell already sourced it.
  token="$(
    set -a
    # shellcheck source=/dev/null # a runtime credential file, not repo content
    . "${secrets_file}" >/dev/null 2>&1 || true
    set +a
    printf '%s' "${GH_TOKEN:-${!var:-}}"
  )"
fi

# A hand-edited credential file with a shell syntax error stops `.` at that
# line, exactly as it stops ~/.bashrc.d/devbox.sh at shell startup - so the
# variable below can be present in the file and still be unreachable. Say which
# of the two it is; "unset" would send someone looking for a missing line.
if [[ -z ${token} && -r ${secrets_file} ]] && ! bash -n "${secrets_file}" 2>/dev/null; then
  printf '%s\n' "devbox-gh-token: ${secrets_file} has a shell syntax error, so nothing after it is read (check it with: bash -n ${secrets_file})" >&2
  exit 1
fi

# No silent fallback to the other account: using the personal token against an
# work repo would either fail confusingly or act as the wrong identity.
if [[ -z ${token} ]]; then
  printf '%s\n' "devbox-gh-token: ${var} is unset - add it to ${secrets_file} (${account} account, selected by ${dir})" >&2
  exit 1
fi

printf '%s\n' "${token}"
