#!/usr/bin/env bash
# Installed by container/bootstrap.sh (devbox) and bin/install-agent (laptop) -
# edit home/.local/bin/devbox-gh-token in the repo.
#
# Print the GitHub token that belongs to a working directory, on the same rule
# git uses to pick an identity: the `dir` prefixes in
# ~/.config/devbox/identities.conf, longest match first, with the one identity
# that has no `dir` catching everything else (docs/git.md). One token per
# account keeps each one fine-grained, expiring and revocable on its own - see
# docs/secrets.md.
#
#   devbox-gh-token                   # token for $PWD
#   devbox-gh-token ~/projects/x      # token for another directory
#   devbox-gh-token --account         # print the identity slug instead
#   devbox-gh-token --identity work   # token for a named identity, ignoring $PWD
#
# The `gh` shim next to this file calls it on every invocation, so the account
# follows the directory even when the shell that started the agent was opened
# somewhere else. Anything that reads the token itself - a curl against the API,
# a project script - should do the same: GH_TOKEN=$(devbox-gh-token).
set -euo pipefail

self_dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
library="${self_dir}/../libexec/devbox-identities"
[[ -r ${library} ]] || library="${HOME}/.local/libexec/devbox-identities"
# shellcheck source=../libexec/devbox-identities
. "${library}"

account_only=false
account=''
while [[ ${1:-} == -* ]]; do
  case "$1" in
  --account)
    account_only=true
    shift
    ;;
  # For a caller that already knows whose token it needs and cannot express it
  # as a directory - the credential helper answering a request for a forge host
  # the working directory's identity does not live on.
  --identity)
    [[ -n ${2:-} ]] || {
      printf '%s\n' 'devbox-gh-token: --identity needs a slug' >&2
      exit 1
    }
    account="$2"
    shift 2
    ;;
  *)
    printf '%s\n' "devbox-gh-token: unknown option $1" >&2
    exit 1
    ;;
  esac
done

dir="${1:-$PWD}"
if [[ -n ${account} ]]; then
  if ! printf '%s\n' "$(di_slugs)" | grep -qx -- "${account}"; then
    printf '%s\n' "devbox-gh-token: no identity [${account}] in ${DEVBOX_IDENTITIES_FILE}" >&2
    exit 1
  fi
else
  account="$(di_for "${dir}")"
fi
if [[ -z ${account} ]]; then
  printf '%s\n' "devbox-gh-token: no identity for ${dir} - check ${DEVBOX_IDENTITIES_FILE} (devbox-identities check)" >&2
  exit 1
fi

if [[ ${account_only} == true ]]; then
  printf '%s\n' "${account}"
  exit 0
fi

var="$(di_get "${account}" token_var)"

# Resolution order, first hit wins:
#   1. an explicit GH_TOKEN in the environment - a deliberate one-off
#      (`GH_TOKEN=$other gh ...`)
#   2. the identity's variable in the environment (a shell that sourced
#      secrets.env through ~/.bashrc.d/devbox.sh)
#   3. the same variable read straight out of secrets.env
#
# Step 3 is what makes this independent of shell startup: a token added to
# secrets.env works in the session that is already open, and the error below is
# then true in every case - the file really is the only place looked at.
if [[ -n ${GH_TOKEN:-} ]]; then
  printf '%s\n' "${GH_TOKEN}"
  exit 0
fi

token="${!var:-}"

secrets_file="${HOME:-/home/dev}/.config/devbox/secrets.env"
if [[ -z ${token} && -r ${secrets_file} ]]; then
  # Read in a subshell so a stray `export`, an unrelated variable or a syntax
  # error in a hand-edited credential file cannot affect this script's own
  # state; only the one value is carried back.
  # `GH_TOKEN` first, mirroring step 1 above: a file that sets both must resolve
  # the same way whether or not the caller's shell already sourced it.
  token="$(
    set -a
    # shellcheck source=/dev/null # a runtime credential file, not repo content
    . "${secrets_file}" >/dev/null 2>&1 || true
    set +a
    printf '%s' "${GH_TOKEN:-${!var:-}}"
  )"
fi

# A hand-edited credential file with a shell syntax error stops `.` at that
# line, exactly as it stops ~/.bashrc.d/devbox.sh at shell startup - so the
# variable below can be present in the file and still be unreachable. Say which
# of the two it is; "unset" would send someone looking for a missing line.
if [[ -z ${token} && -r ${secrets_file} ]] && ! bash -n "${secrets_file}" 2>/dev/null; then
  printf '%s\n' "devbox-gh-token: ${secrets_file} has a shell syntax error, so nothing after it is read (check it with: bash -n ${secrets_file})" >&2
  exit 1
fi

# No silent fallback to another identity: using one account's token against
# another's repository would either fail confusingly or act as the wrong person.
if [[ -z ${token} ]]; then
  printf '%s\n' "devbox-gh-token: ${var} is unset - add it to ${secrets_file} (${account} identity, selected by ${dir})" >&2
  exit 1
fi

printf '%s\n' "${token}"
