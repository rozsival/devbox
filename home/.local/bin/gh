#!/usr/bin/env bash
# Generated by container/bootstrap.sh - edit home/.local/bin/gh in the repo.
#
# PATH shim in front of the real `gh` (/usr/bin/gh, from the .deb the Dockerfile
# installs). ~/.local/bin comes first on the PATH set by ~/.bashrc.d/devbox.sh,
# so every caller that inherits it - a pane, `ssh devbox <cmd>`, an agent
# spawning gh - lands here first.
#
# Why a shim and not an exported GH_TOKEN: the account has to be chosen from the
# *current* directory, not from wherever the shell happened to start. Agents run
# with a project as their cwd inside a session that was opened in $HOME, so a
# value exported at shell startup would pin one account for the whole session.
# Resolving per invocation is the only way the choice can follow the tree, the
# same way git's `includeIf` does. See docs/secrets.md.
set -euo pipefail

readonly REAL_GH=/usr/bin/gh

if [[ ! -x ${REAL_GH} ]]; then
  printf '%s\n' "gh shim: ${REAL_GH} is missing - rebuild the image (./bin/devbox rebuild)" >&2
  exit 127
fi

# The resolver explains itself on stderr when no token is configured for this
# tree; let that through and still run gh, which then acts unauthenticated and
# fails on its own terms rather than silently using the other account's token.
token="$("$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/devbox-gh-token")" || token=''
if [[ -n ${token} ]]; then
  export GH_TOKEN="${token}"
fi

exec "${REAL_GH}" "$@"
