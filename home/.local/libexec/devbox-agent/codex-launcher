#!/usr/bin/env bash
# Installed by container/bootstrap.sh (devbox) and `devbox agent install` (laptop) -
# edit home/.local/libexec/devbox-agent/codex-launcher in the repo.
#
# PATH launcher in front of the real `codex` (OpenAI Codex CLI): every Codex
# session runs under the agent git override. The body is shared with
# omp-launcher and claude-launcher - see agent-launch next to this file and
# docs/git.md.
#
# The real `codex` is the standalone install's ~/.local/bin/codex, a symlink
# the installer (and `codex update`) re-points into ~/.codex/packages at every
# release, or Homebrew's on the laptop - so the launcher symlink can never live
# there, only in a directory ahead of it on the PATH.
#
# OPENAI_API_KEY and CODEX_API_KEY are dropped for Codex's process tree: one
# exported from secrets.env or a shell would otherwise be billed instead of the
# ChatGPT sign-in. Codex runs on the subscription; a project's own LLM calls take
# their key from that project's .env, not from here.
#
# --no-daemon keeps the session off Codex's shared background server (0.157+),
# even one already running. That server runs every attached session under the
# environment of whatever started it - the desktop app, a bare ~/.local/bin/codex
# - so attaching would drop the fence exported below. Every subcommand accepts it
# before its name, `update` included.
set -euo pipefail
unset OPENAI_API_KEY CODEX_API_KEY

self="$(readlink -f "${BASH_SOURCE[0]}")"
# shellcheck source=agent-launch
. "$(dirname "${self}")/agent-launch"
agent_launch codex "${self}" 'install Codex (curl -fsSL https://chatgpt.com/codex/install.sh | sh)' --no-daemon "$@"
