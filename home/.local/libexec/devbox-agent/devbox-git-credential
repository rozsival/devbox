#!/usr/bin/env bash
# Installed by container/bootstrap.sh (devbox) and bin/install-agent (laptop) -
# edit home/.local/libexec/devbox-agent/devbox-git-credential in the repo.
#
# Git credential helper for agent sessions, configured by
# ~/.config/devbox/agent.gitconfig for https://github.com with useHttpPath, so
# every request names the repository. A token is minted per git operation and
# never stored:
#
#   1. the work-app GitHub App, if it is installed on that repository -
#      an installation token restricted to that one repository, valid one hour
#      (`GET /repos/{owner}/{repo}/installation` decides; no allowlist to keep)
#   2. otherwise the fine-grained PAT of the account the working directory
#      belongs to, from devbox-gh-token - the same rule `gh` uses
#
# Anything that is not GitHub over HTTPS gets no answer, so git fails on its own
# terms. `store` and `erase` are accepted and ignored: there is nothing to keep.
#
#   devbox-git-credential get                 # git credential protocol on stdin
#   devbox-git-credential explain owner/repo  # app:<installation-id> or pat:<account>, no token minted
set -euo pipefail

readonly APP_DIR="${HOME}/.config/work/work-app"
readonly API='https://api.github.com'

die() {
  printf 'devbox-git-credential: %s\n' "$*" >&2
  exit 1
}

b64url() {
  openssl base64 -A | tr '+/' '-_' | tr -d '='
}

# Sets `http_code` and `body`. Never -f: a 404 is an answer here, not an error.
api() {
  local method="$1" url="$2" auth="$3" data="${4:-}"
  local -a args=(-sS --max-time 20 -X "${method}" -o "${tmp}" -w '%{http_code}'
    -H "Authorization: Bearer ${auth}"
    -H 'Accept: application/vnd.github+json'
    -H 'X-GitHub-Api-Version: 2022-11-28')
  [[ -n ${data} ]] && args+=(-H 'Content-Type: application/json' -d "${data}")
  http_code="$(curl "${args[@]}" "${url}")" || die "cannot reach ${url}"
  body="$(cat "${tmp}")"
}

app_jwt() {
  local app_id now header payload signature
  app_id="$(tr -d '[:space:]' <"${APP_DIR}/app-id")"
  [[ -n ${app_id} ]] || die "${APP_DIR}/app-id is empty"
  now="$(date +%s)"
  header="$(printf '%s' '{"alg":"RS256","typ":"JWT"}' | b64url)"
  # iat backdated for clock skew; exp well inside GitHub's ten-minute ceiling.
  payload="$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' "$((now - 60))" "$((now + 300))" "${app_id}" | b64url)"
  signature="$(printf '%s.%s' "${header}" "${payload}" | openssl dgst -sha256 -sign "${APP_DIR}/app.pem" -binary | b64url)" ||
    die "cannot sign with ${APP_DIR}/app.pem"
  printf '%s.%s.%s' "${header}" "${payload}" "${signature}"
}

# Prints the installation id when the App is installed on owner/repo, nothing
# when it is not, and dies on every other answer: a broken pem or an API outage
# must not quietly downgrade to the PAT and act as a different identity.
app_installation() {
  local owner="$1" repo="$2"
  [[ -r ${APP_DIR}/app-id && -r ${APP_DIR}/app.pem ]] || return 0
  api GET "${API}/repos/${owner}/${repo}/installation" "$(app_jwt)"
  case "${http_code}" in
  200) jq -r '.id' <<<"${body}" ;;
  404) ;;
  *) die "GitHub App installation lookup for ${owner}/${repo} failed with HTTP ${http_code}: $(jq -r '.message // empty' <<<"${body}" 2>/dev/null)" ;;
  esac
}

app_token() {
  local installation="$1" repo="$2"
  api POST "${API}/app/installations/${installation}/access_tokens" "$(app_jwt)" \
    "$(jq -cn --arg repo "${repo}" '{repositories: [$repo]}')"
  [[ ${http_code} == 201 ]] || die "minting an installation token for ${repo} failed with HTTP ${http_code}: $(jq -r '.message // empty' <<<"${body}" 2>/dev/null)"
  jq -r '.token' <<<"${body}"
}

pat() {
  local resolver
  resolver="$(command -v devbox-gh-token || printf '%s' "${HOME}/.local/bin/devbox-gh-token")"
  [[ -x ${resolver} ]] || die "devbox-gh-token is not installed"
  "${resolver}" "$@"
}

# owner/repo from the request path, which may carry a .git suffix or - on a
# request without useHttpPath - be absent altogether.
split_path() {
  local path="${1%.git}"
  path="${path#/}"
  owner="${path%%/*}"
  repo="${path#*/}"
  repo="${repo%%/*}"
  [[ -n ${owner} && -n ${repo} && ${owner} != "${repo}" ]] || {
    owner=''
    repo=''
  }
}

tmp="$(mktemp)"
trap 'rm -f "${tmp}"' EXIT

case "${1:-}" in
get)
  protocol='' host='' path=''
  while IFS= read -r line; do
    [[ -z ${line} ]] && break
    case "${line}" in
    protocol=*) protocol="${line#protocol=}" ;;
    host=*) host="${line#host=}" ;;
    path=*) path="${line#path=}" ;;
    esac
  done
  [[ ${protocol} == https && ${host} == github.com ]] || exit 0

  split_path "${path}"
  token=''
  if [[ -n ${owner} ]]; then
    installation="$(app_installation "${owner}" "${repo}")"
    [[ -n ${installation} ]] && token="$(app_token "${installation}" "${repo}")"
  fi
  [[ -n ${token} ]] || token="$(pat)"

  printf 'username=x-access-token\npassword=%s\n' "${token}"
  ;;
store | erase)
  exit 0
  ;;
explain)
  [[ -n ${2:-} ]] || die 'usage: devbox-git-credential explain owner/repo [directory]'
  split_path "$2"
  [[ -n ${owner} ]] || die "not an owner/repo: $2"
  installation="$(app_installation "${owner}" "${repo}")"
  if [[ -n ${installation} ]]; then
    printf 'app:%s\n' "${installation}"
  else
    printf 'pat:%s\n' "$(pat --account "${3:-$PWD}")"
  fi
  ;;
*)
  die 'usage: devbox-git-credential get|store|erase | explain owner/repo [directory]'
  ;;
esac
