#!/usr/bin/env bash
# Installed by container/bootstrap.sh (devbox) and bin/install-agent (laptop) -
# edit home/.local/libexec/devbox-agent/devbox-git-credential in the repo.
#
# Git credential helper for agent sessions, configured by
# ~/.config/devbox/git/agent.gitconfig for every forge host in
# ~/.config/devbox/identities.conf with useHttpPath, so each request names the
# repository. A token is minted per git operation and never stored:
#
#   1. a GitHub App installation token, from the first identity whose `app`
#      credentials exist and whose App is installed on that repository -
#      restricted to that one repository, valid one hour
#      (`GET /repos/{owner}/{repo}/installation` decides; no allowlist to keep).
#      The identity owning the working directory is tried first, so two accounts
#      with two Apps stay apart.
#   2. otherwise the fine-grained PAT of the identity the working directory
#      belongs to, from devbox-gh-token - the same rule `gh` uses
#
# Anything that is not a configured forge host over HTTPS gets no answer, so git
# fails on its own terms. `store` and `erase` are accepted and ignored: there is
# nothing to keep.
#
#   devbox-git-credential get                 # git credential protocol on stdin
#   devbox-git-credential explain owner/repo  # app:<installation-id> or pat:<identity>, no token minted
set -euo pipefail

self_dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
library="${self_dir}/devbox-identities"
[[ -r ${library} ]] || library="${self_dir}/../devbox-identities"
[[ -r ${library} ]] || library="${HOME}/.local/libexec/devbox-identities"
# shellcheck source=../devbox-identities
. "${library}"

die() {
  printf 'devbox-git-credential: %s\n' "$*" >&2
  exit 1
}

b64url() {
  openssl base64 -A | tr '+/' '-_' | tr -d '='
}

# Sets `http_code` and `body`. Never -f: a 404 is an answer here, not an error.
api() {
  local method="$1" url="$2" auth="$3" data="${4:-}"
  local -a args=(-sS --max-time 20 -X "${method}" -o "${tmp}" -w '%{http_code}'
    -H "Authorization: Bearer ${auth}"
    -H 'Accept: application/vnd.github+json'
    -H 'X-GitHub-Api-Version: 2022-11-28')
  [[ -n ${data} ]] && args+=(-H 'Content-Type: application/json' -d "${data}")
  http_code="$(curl "${args[@]}" "${url}")" || die "cannot reach ${url}"
  body="$(cat "${tmp}")"
}

app_jwt() {
  local app_dir="$1" app_id now header payload signature
  app_id="$(tr -d '[:space:]' <"${app_dir}/app-id")"
  [[ -n ${app_id} ]] || die "${app_dir}/app-id is empty"
  now="$(date +%s)"
  header="$(printf '%s' '{"alg":"RS256","typ":"JWT"}' | b64url)"
  # iat backdated for clock skew; exp well inside GitHub's ten-minute ceiling.
  payload="$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' "$((now - 60))" "$((now + 300))" "${app_id}" | b64url)"
  signature="$(printf '%s.%s' "${header}" "${payload}" | openssl dgst -sha256 -sign "${app_dir}/app.pem" -binary | b64url)" ||
    die "cannot sign with ${app_dir}/app.pem"
  printf '%s.%s.%s' "${header}" "${payload}" "${signature}"
}

# The identities that could serve a request for `host`: the one owning the
# working directory first, then the rest in config order.
candidates() {
  local host="$1" dir="$2" owner slug
  owner="$(di_for "${dir}")"
  [[ "$(di_get "${owner}" host)" != "${host}" ]] || printf '%s\n' "${owner}"
  for slug in $(di_slugs); do
    [[ ${slug} != "${owner}" ]] || continue
    [[ "$(di_get "${slug}" host)" == "${host}" ]] || continue
    printf '%s\n' "${slug}"
  done
}

# Prints `<slug> <installation-id>` for the first identity whose App is
# installed on owner/repo, nothing when none is, and dies on every other answer:
# a broken pem or an API outage must not quietly downgrade to a PAT and act as a
# different identity.
app_installation() {
  local host="$1" dir="$2" owner="$3" repo="$4" slug app_dir
  while IFS= read -r slug; do
    app_dir="$(di_get "${slug}" app)"
    [[ -n ${app_dir} && -r ${app_dir}/app-id && -r ${app_dir}/app.pem ]] || continue
    api GET "$(di_get "${slug}" api)/repos/${owner}/${repo}/installation" "$(app_jwt "${app_dir}")"
    case "${http_code}" in
    200)
      printf '%s %s\n' "${slug}" "$(jq -r '.id' <<<"${body}")"
      return 0
      ;;
    404) ;;
    *) die "GitHub App installation lookup for ${owner}/${repo} as ${slug} failed with HTTP ${http_code}: $(jq -r '.message // empty' <<<"${body}" 2>/dev/null)" ;;
    esac
  done < <(candidates "${host}" "${dir}")
}

app_token() {
  local slug="$1" installation="$2" repo="$3" app_dir
  app_dir="$(di_get "${slug}" app)"
  api POST "$(di_get "${slug}" api)/app/installations/${installation}/access_tokens" "$(app_jwt "${app_dir}")" \
    "$(jq -cn --arg repo "${repo}" '{repositories: [$repo]}')"
  [[ ${http_code} == 201 ]] || die "minting an installation token for ${repo} as ${slug} failed with HTTP ${http_code}: $(jq -r '.message // empty' <<<"${body}" 2>/dev/null)"
  jq -r '.token' <<<"${body}"
}

pat() {
  local resolver
  resolver="$(command -v devbox-gh-token || printf '%s' "${HOME}/.local/bin/devbox-gh-token")"
  [[ -x ${resolver} ]] || die "devbox-gh-token is not installed"
  "${resolver}" "$@"
}

# owner/repo from the request path, which may carry a .git suffix or - on a
# request without useHttpPath - be absent altogether.
split_path() {
  local path="${1%.git}"
  path="${path#/}"
  owner="${path%%/*}"
  repo="${path#*/}"
  repo="${repo%%/*}"
  [[ -n ${owner} && -n ${repo} && ${owner} != "${repo}" ]] || {
    owner=''
    repo=''
  }
}

# A host nothing in the registry claims gets no credential at all.
known_host() {
  local host="$1" slug
  for slug in $(di_slugs); do
    [[ "$(di_get "${slug}" host)" != "${host}" ]] || return 0
  done
  return 1
}

tmp="$(mktemp)"
trap 'rm -f "${tmp}"' EXIT

case "${1:-}" in
get)
  protocol='' host='' path=''
  while IFS= read -r line; do
    [[ -z ${line} ]] && break
    case "${line}" in
    protocol=*) protocol="${line#protocol=}" ;;
    host=*) host="${line#host=}" ;;
    path=*) path="${line#path=}" ;;
    esac
  done
  [[ ${protocol} == https ]] || exit 0
  known_host "${host}" || exit 0

  split_path "${path}"
  token=''
  if [[ -n ${owner} ]]; then
    found="$(app_installation "${host}" "${PWD}" "${owner}" "${repo}")"
    [[ -z ${found} ]] || token="$(app_token "${found%% *}" "${found##* }" "${repo}")"
  fi
  # Only when no App minted one above: an installation token is repository
  # scoped and is always the better credential where it exists.
  if [[ -z ${token} ]]; then
    # The PAT of the working directory's identity - unless that identity lives
    # on another forge than the one being asked for, in which case its token
    # would be rejected there (and sent to a host it was never issued for).
    # Then take the first identity that does live on this host.
    if [[ "$(di_get "$(di_for "${PWD}")" host)" == "${host}" ]]; then
      token="$(pat)"
    else
      host_slug="$(candidates "${host}" "${PWD}" | head -1)"
      [[ -n ${host_slug} ]] || die "no identity for ${host} in ${DEVBOX_IDENTITIES_FILE}"
      token="$(pat --identity "${host_slug}")"
    fi
  fi

  printf 'username=x-access-token\npassword=%s\n' "${token}"
  ;;
store | erase)
  exit 0
  ;;
explain)
  [[ -n ${2:-} ]] || die 'usage: devbox-git-credential explain owner/repo [directory]'
  split_path "$2"
  [[ -n ${owner} ]] || die "not an owner/repo: $2"
  dir="${3:-$PWD}"
  host="$(di_get "$(di_for "${dir}")" host)"
  found="$(app_installation "${host}" "${dir}" "${owner}" "${repo}")"
  if [[ -n ${found} ]]; then
    printf 'app:%s:%s\n' "${found%% *}" "${found##* }"
  else
    printf 'pat:%s\n' "$(pat --account "${dir}")"
  fi
  ;;
*)
  die 'usage: devbox-git-credential get|store|erase | explain owner/repo [directory]'
  ;;
esac
