#!/usr/bin/env bash
# Installed by container/bootstrap.sh (devbox) and `devbox agent install` (laptop) -
# edit home/.local/libexec/devbox-agent/omp-launcher in the repo.
#
# PATH launcher in front of the real `omp`: every OMP session runs under the
# agent git override. The body is shared with claude-launcher - see
# agent-launch next to this file and docs/git.md.
set -euo pipefail

self="$(readlink -f "${BASH_SOURCE[0]}")"
# shellcheck source=agent-launch
. "$(dirname "${self}")/agent-launch"
agent_launch omp "${self}" 'install OMP (curl -fsSL https://omp.sh/install.sh | sh)' "$@"
