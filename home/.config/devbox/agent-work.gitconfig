# Installed by container/bootstrap.sh (devbox) and bin/install-agent (laptop) -
# edit home/.config/devbox/agent-work.gitconfig in the repo.
#
# Pulled in by ~/.config/devbox/agent.gitconfig for ~/projects/work/**: agent
# commits there are authored as the work-app GitHub App's bot user, the
# same App whose installation token pushes them. The address is GitHub's
# noreply form for that user (`gh api '/users/work-app[bot]'` → id), so
# the commits link to the bot's profile and avatar.
[user]
	name = work-app[bot]
	email = 00000000+work-app[bot]@users.noreply.github.com
