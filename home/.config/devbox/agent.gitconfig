# Installed by container/bootstrap.sh (devbox) and bin/install-agent (laptop) -
# edit home/.config/devbox/agent.gitconfig in the repo.
#
# The git configuration of an agent session. The `omp` launcher in
# ~/.local/libexec/devbox-agent exports GIT_CONFIG_GLOBAL pointing here, so every
# git the agent runs - and every tool that shells out to git: gh, wt, lazygit,
# OMP itself - reads this file *instead of* ~/.gitconfig. Nothing else on the
# machine sees it: the same clone opened in an IDE or a plain shell keeps its SSH
# remote, the 1Password agent and the signing key. See docs/git.md.
#
# Self-contained on purpose. ~/.gitconfig carries `url.<ssh-alias>.insteadOf`
# rewrites for the same prefixes as below, and when two rewrites tie on length
# git keeps the first one it read - so including that file would let an SSH
# rewrite win over the HTTPS one.

# The author of every agent commit outside ~/projects/work/. Not an account:
# the pusher is the personal fine-grained PAT, the author is visibly not you.
[user]
	name = rozsival-agent
	email = rozsival-agent@users.noreply.github.com

# Unsigned: the signing keys are yours, and never within an agent's reach.
[commit]
	gpgsign = false
[tag]
	gpgsign = false

# Every GitHub remote goes over HTTPS whatever URL the clone was made with, and
# the helper mints a token per operation: a repository-scoped GitHub App
# installation token where the App is installed, a fine-grained PAT elsewhere.
# The user-less `github.com:` forms are what an `ssh` config with `User git`
# lets a clone get away with; `gh:` is the personal ~/.gitconfig shorthand.
[url "https://github.com/"]
	insteadOf = git@github.com:
	insteadOf = git@work.github.com:
	insteadOf = github.com:
	insteadOf = work.github.com:
	insteadOf = ssh://git@github.com/
	insteadOf = gh:

# The empty entry resets the helper list inherited from the system config
# (osxkeychain on macOS, gh's own helper if it was ever configured): an agent
# must never reach a credential stored for you. Any non-GitHub HTTPS remote is
# therefore left without a helper and fails - GIT_TERMINAL_PROMPT=0 in the
# launcher turns that into an immediate error rather than a hung prompt.
# `!` runs the value as a shell command found on the PATH the launcher set; a
# bare name would be looked up as `git credential-<name>`, and an absolute
# path would tie this file to one machine's home directory.
[credential "https://github.com"]
	helper = !devbox-git-credential
	useHttpPath = true

[init]
	defaultBranch = main
[pull]
	rebase = true
	ff = only
[push]
	default = simple
	followTags = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

# Same directory rule as ~/.gitconfig: work repositories get the App's own
# bot identity. Must stay after [user] - later wins.
[includeIf "gitdir:~/projects/work/"]
	path = ~/.config/devbox/agent-work.gitconfig
